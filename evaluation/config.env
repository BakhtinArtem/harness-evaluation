#!/usr/bin/env bash
# Shared benchmark configuration for all evaluation experiments.
# Source this file from any runner script: source "$(dirname "$0")/../config.env"

# --- Experiment parameters ---
REPETITIONS=3
RATES="${RATES:-50 200 500 1000}"
DURATION_STEADY="30s"
DURATION_COLD="30s"
WARMUP_DURATION="10s"
WARMUP_RATE=100

# --- wrk2 parameters ---
WRK2_THREADS=2
WRK2_CONNECTIONS=5
WRK2_IMAGE="eval-wrk2:latest"

# --- Spring Boot Petclinic ---
SPRING_SERVICE_NAME="petclinic"
SPRING_PORT=9966
SPRING_IMAGE="aape2k/spring-petclinic-rest:v2.0.0"
SPRING_API_BASE="/petclinic/api"
SPRING_COMPOSE="docker/spring-bench.yml"
SPRING_OPENAPI="../benchmark-app/spring-petclinic-rest/src/main/resources/openapi.yml"

# --- Spring Boot Petclinic (Native, GraalVM) -- for DP4: Java runtime comparison ---
SPRING_NATIVE_SERVICE_NAME="petclinic"
SPRING_NATIVE_PORT=9966
SPRING_NATIVE_IMAGE="aape2k/spring-petclinic-rest-native:v1.0.0"
SPRING_NATIVE_API_BASE="/petclinic/api"
SPRING_NATIVE_COMPOSE="docker/spring-native-bench.yml"
SPRING_NATIVE_OPENAPI="../benchmark-app/spring-petclinic-rest/src/main/resources/openapi.yml"

# --- Quarkus Petclinic (native) ---
QUARKUS_SERVICE_NAME="quarkus-petclinic"
QUARKUS_PORT=8080
QUARKUS_IMAGE="aape2k/quarkus-petclinic:v1.0.0"
QUARKUS_API_BASE="/api"
QUARKUS_COMPOSE="docker/quarkus-bench.yml"
QUARKUS_OPENAPI="../benchmark-app/quarkus-petclinic/src/main/resources/META-INF/openapi.yaml"

# --- Quarkus Petclinic (JVM) -- for DP4: Java runtime comparison ---
QUARKUS_JVM_SERVICE_NAME="quarkus-petclinic-jvm"
QUARKUS_JVM_PORT=8080
QUARKUS_JVM_IMAGE="aape2k/quarkus-petclinic-jvm:v1.0.0"
QUARKUS_JVM_API_BASE="/api"
QUARKUS_JVM_COMPOSE="docker/quarkus-jvm-bench.yml"
QUARKUS_JVM_OPENAPI="../benchmark-app/quarkus-petclinic/src/main/resources/META-INF/openapi.yaml"

# --- Go Petclinic ---
GO_SERVICE_NAME="go-petclinic"
GO_PORT=9966
GO_IMAGE="aape2k/go-petclinic:v1.0.0"
GO_API_BASE="/petclinic/api"
GO_COMPOSE="docker/go-bench.yml"
GO_OPENAPI="../benchmark-app/go-petclinic/resources/openapi.yml"

# --- slsbench (DooD) ---
SLSBENCH_IMAGE="aape2k/slsbench:v3.0.0"
DOCKER_SOCKET="/var/run/docker.sock"

# --- Timing ---
FIRST_RESPONSE_TIMEOUT=120
FIRST_RESPONSE_INTERVAL_MS=200
STATS_INTERVAL_S=1
