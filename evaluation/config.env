#!/usr/bin/env bash
# Shared benchmark configuration for all evaluation experiments.
# Source this file from any runner script: source "$(dirname "$0")/../config.env"

# --- Experiment parameters ---
REPETITIONS=3
RATES="${RATES:-50 200 500 1000}"
DURATION_STEADY="30s"
DURATION_COLD="30s"
WARMUP_DURATION="10s"
WARMUP_RATE=100

# --- wrk2 parameters ---
WRK2_THREADS=2
WRK2_CONNECTIONS=5
WRK2_IMAGE="eval-wrk2:latest"

# --- Spring Boot Petclinic ---
SPRING_SERVICE_NAME="petclinic"
SPRING_PORT=9966
SPRING_IMAGE="aape2k/spring-petclinic-rest"
SPRING_API_BASE="/petclinic/api"
SPRING_COMPOSE="docker/spring-bench.yml"
SPRING_OPENAPI="../benchmark-app/spring-petclinic-rest/src/main/resources/openapi.yml"

# --- Quarkus Petclinic (native) ---
QUARKUS_SERVICE_NAME="quarkus-petclinic"
QUARKUS_PORT=8080
QUARKUS_IMAGE="aape2k/quarkus-petclinic"
QUARKUS_API_BASE="/api"
QUARKUS_COMPOSE="docker/quarkus-bench.yml"
QUARKUS_OPENAPI="../benchmark-app/quarkus-petclinic/src/main/resources/META-INF/openapi.yaml"

# --- Quarkus Petclinic (JVM) -- for DP4: Java runtime comparison ---
QUARKUS_JVM_SERVICE_NAME="quarkus-petclinic-jvm"
QUARKUS_JVM_PORT=8080
QUARKUS_JVM_IMAGE="aape2k/quarkus-petclinic-jvm"
QUARKUS_JVM_API_BASE="/api"
QUARKUS_JVM_COMPOSE="docker/quarkus-jvm-bench.yml"
QUARKUS_JVM_OPENAPI="../benchmark-app/quarkus-petclinic/src/main/resources/META-INF/openapi.yaml"

# --- slsbench (DooD) ---
SLSBENCH_IMAGE="slsbench:dood"
DOCKER_SOCKET="/var/run/docker.sock"

# --- Timing ---
FIRST_RESPONSE_TIMEOUT=120
FIRST_RESPONSE_INTERVAL_MS=200
STATS_INTERVAL_S=1
